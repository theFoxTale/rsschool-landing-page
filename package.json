{
    "name": "rsschool-landing-page",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . && stylelint \"scss/**/*.scss\"",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "sass": "^1.105.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^7.1.5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "node ./node_modules/eslint/bin/eslint.js --fix",
            "node ./node_modules/prettier/bin/prettier.cjs --write"
        ],
        "*.{css,scss}": [
            "node ./node_modules/stylelint/bin/stylelint.mjs --fix",
            "node ./node_modules/prettier/bin/prettier.cjs --write"
        ],
        "*.{html,json,md}": [
            "node ./node_modules/prettier/bin/prettier.cjs --write"
        ]
    }
}
